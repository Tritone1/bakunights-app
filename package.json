{
  "name": "haragedek",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @haragedek/web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:fullstack": "concurrently -n api,web -c magenta,yellow \"npm run dev -w @haragedek/api\" \"npm run dev -w @haragedek/web\"",
    "build": "npm run build -w @haragedek/web",
    "build:all": "npm run build -w @haragedek/api && npm run build -w @haragedek/web",
    "typecheck": "npm run typecheck -w @haragedek/web",
    "typecheck:all": "npm run typecheck -w @haragedek/api && npm run typecheck -w @haragedek/web",
    "lint": "npm run lint -w @haragedek/web",
    "lint:mobile": "npm --prefix apps/mobile run lint",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "db:generate": "npm run db:generate -w @haragedek/api",
    "db:migrate": "npm run db:migrate -w @haragedek/api",
    "db:deploy": "npm run db:deploy -w @haragedek/api",
    "db:seed": "npm run db:seed -w @haragedek/api",
    "railway:start": "npm run db:deploy && npm run start -w @haragedek/api"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.5",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo": "^54.0.2"
  },
  "optionalDependencies": {
    "@emnapi/wasi-threads": "^1.2.1"
  }
}
