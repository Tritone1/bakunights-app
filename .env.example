# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grub_stub?schema=public"

# API and sessions
PORT=4000
API_HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Gmail SMTP for registration verification. Use a Gmail App Password, never your normal password.
GMAIL_SENDER_EMAIL="kanan.hli0@gmail.com"
GMAIL_APP_PASSWORD=""

# Optional: enables menu photo/PDF extraction in the merchant dashboard.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"

# Server-side Google Maps key (optional for API-side place features)
GOOGLE_MAPS_API_KEY=""

# Vite client configuration
VITE_API_URL="/api"
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID=""

# Optional web-push keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
