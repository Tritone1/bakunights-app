# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grub_stub?schema=public"

# API and sessions
PORT=4000
API_HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Gmail API for registration verification. Keep all OAuth values server-side.
GMAIL_SENDER_EMAIL="hkenan40@gmail.com"
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
# Optional local SMTP fallback. Railway blocks Gmail SMTP ports.
GMAIL_APP_PASSWORD=""

# Optional: enables menu photo/PDF extraction in the merchant dashboard.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"

# Persistent image storage (Cloudinary). Keep secrets server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="bakunights"
# Usually: https://res.cloudinary.com/<cloud-name>/image/upload
CLOUDINARY_PUBLIC_BASE_URL=""

# Server-only Places API key. Never expose this through a VITE_ variable.
GOOGLE_MAPS_SERVER_API_KEY=""

# Vite client configuration
VITE_API_URL="/api"
# Browser-only Maps JavaScript API key. This is the map-rendering source of truth.
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID=""

# Optional web-push keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"
VITE_VAPID_PUBLIC_KEY=""
