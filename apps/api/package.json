    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.13.0",
