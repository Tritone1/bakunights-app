generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  MERCHANT
  ADMIN
}

enum ClaimStatus {
  unclaimed
  pending_verification
  verified
}

enum DealStatus {
  draft
  pending_review
  approved
  rejected
  expired
}

enum ClaimRequestStatus {
  pending
  approved
  rejected
}

enum DealOfferType {
  discount
  combo
  set_menu
  perk
  event
  bundle
  other
}

enum OfferScope {
  WHOLE_MENU
  CATEGORY
  SPECIFIC_ITEMS
}

enum VenueFlagStatus {
  OPEN
  RESOLVED
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  emailVerifiedAt DateTime?          @map("email_verified_at")
  passwordHash    String?            @map("password_hash")
  name            String
  role            UserRole           @default(CONSUMER)
  merchantVenueName String?          @map("merchant_venue_name")
  merchantVenueImage Bytes?          @map("merchant_venue_image")
  merchantVenueImageMime String?     @map("merchant_venue_image_mime")
  merchantVenueImageName String?     @map("merchant_venue_image_name")
  merchantVenueAddress String?       @map("merchant_venue_address")
  merchantVenueLat Float?            @map("merchant_venue_lat")
  merchantVenueLng Float?            @map("merchant_venue_lng")
  homeLat         Float?             @map("home_lat")
  homeLng         Float?             @map("home_lng")
  preferencesJson Json?              @map("preferences_json")
  createdAt       DateTime           @default(now()) @map("created_at")
  ownedRestaurants Restaurant[]      @relation("RestaurantOwner")
  savedDeals      SavedDeal[]
  redemptions     Redemption[]
  follows         Follow[]
  ratings         DealRating[]
  subscriptions   PushSubscription[]
  claims          VenueClaimRequest[] @relation("VenueClaimRequester")
  notificationLogs NotificationLog[]
  submittedDeals  Deal[]              @relation("DealSubmitter")
  reviewedDeals   Deal[]              @relation("DealReviewer")
  auditLogs       AuditLog[]          @relation("AuditActor")
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Restaurant {
  id            String            @id @default(cuid())
  googlePlaceId String?           @unique @map("google_place_id")
  name          String
  cuisine       String
  dietaryTags   String[]          @default([]) @map("dietary_tags")
  address       String
  lat           Float
  lng           Float
  phone         String?
  hoursJson     Json?             @map("hours_json")
  photoUrl      String?           @map("photo_url")
  rating        Float             @default(0)
  isActive      Boolean           @default(true) @map("is_active")
  autoApproveOffers Boolean       @default(false) @map("auto_approve_offers")
  isVerifiedTrusted Boolean       @default(false) @map("is_verified_trusted")
  trustedBadgeRevoked Boolean     @default(false) @map("trusted_badge_revoked")
  honestyRate  Float?             @map("honesty_rate")
  ownerUserId   String?           @map("owner_user_id")
  claimStatus   ClaimStatus       @default(unclaimed) @map("claim_status")
  verificationNotes String?       @map("verification_notes")
  owner         User?             @relation("RestaurantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deals         Deal[]
  followers     Follow[]
  claims        VenueClaimRequest[]
  menuItems     MenuItem[]
  trustFlags    VenueTrustFlag[]

  @@map("restaurants")
}

model Deal {
  id              String        @id @default(cuid())
  restaurantId    String        @map("restaurant_id")
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title           String
  description     String
  menuItem        String?       @map("menu_item")
  photoUrl        String?       @map("photo_url") @db.Text
  scope           OfferScope    @default(WHOLE_MENU)
  scopeCategoryId String?       @map("scope_category_id")
  scopeCategory   MenuCategory? @relation("ScopedDealCategory", fields: [scopeCategoryId], references: [id], onDelete: SetNull)
  offerType       DealOfferType @default(discount) @map("offer_type")
  discountPct     Int?          @map("discount_pct")
  tag             String
  dietaryTags     String[]      @default([]) @map("dietary_tags")
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime      @map("ends_at")
  isActive        Boolean       @default(true) @map("is_active")
  isRecurring     Boolean       @default(false) @map("is_recurring")
  recurrenceRule  String?       @map("recurrence_rule")
  status          DealStatus    @default(pending_review)
  submittedByUserId String?     @map("submitted_by_user_id")
  submittedBy     User?         @relation("DealSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId String?      @map("reviewed_by_user_id")
  reviewedBy      User?         @relation("DealReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes     String?       @map("review_notes")
  submittedAt     DateTime?     @map("submitted_at")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  savedBy         SavedDeal[]
  redemptions     Redemption[]
  ratings         DealRating[]
  views           DealView[]
  notificationLogs NotificationLog[]
  offerMenuItems  OfferMenuItem[]

  @@index([isActive, startsAt, endsAt])
  @@map("deals")
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]
  scopedDeals Deal[]   @relation("ScopedDealCategory")
  catalogItems CatalogItem[]

  @@index([sortOrder])
  @@map("menu_categories")
}

model CatalogItem {
  id          String       @id @default(cuid())
  name        String       @unique
  categoryId  String       @map("category_id")
  photoUrl    String?      @map("photo_url") @db.Text
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, isActive])
  @@map("catalog_items")
}

model MenuItem {
  id          String       @id @default(cuid())
  venueId     String       @map("venue_id")
  categoryId  String       @map("category_id")
  name        String
  priceAzn    Decimal      @map("price_azn") @db.Decimal(10, 2)
  description String?
  photoUrl    String?      @map("photo_url")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  venue       Restaurant   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offerLinks  OfferMenuItem[]

  @@index([venueId, categoryId, isActive])
  @@map("menu_items")
}

model OfferMenuItem {
  offerId         String   @map("offer_id")
  menuItemId      String   @map("menu_item_id")
  overridePriceAzn Decimal? @map("override_price_azn") @db.Decimal(10, 2)
  offer           Deal     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([offerId, menuItemId])
  @@map("offer_menu_items")
}

model SavedDeal {
  userId   String   @map("user_id")
  dealId   String   @map("deal_id")
  savedAt  DateTime @default(now()) @map("saved_at")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([userId, dealId])
  @@map("saved_deals")
}

model Redemption {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  dealId         String   @map("deal_id")
  claimedAt      DateTime @default(now()) @map("claimed_at")
  redeemedAt     DateTime? @map("redeemed_at")
  feedbackSkippedAt DateTime? @map("feedback_skipped_at")
  redemptionCode String   @unique @map("redemption_code")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  feedback       RedemptionFeedback?

  @@unique([userId, dealId])
  @@map("redemptions")
}

model RedemptionFeedback {
  id          String     @id @default(cuid())
  redemptionId String    @unique @map("redemption_id")
  wasHonored  Boolean    @map("was_honored")
  comment     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  redemption  Redemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("redemption_feedback")
}

model VenueTrustFlag {
  id          String          @id @default(cuid())
  venueId     String          @map("venue_id")
  reason      String
  status      VenueFlagStatus @default(OPEN)
  createdAt   DateTime        @default(now()) @map("created_at")
  resolvedAt  DateTime?       @map("resolved_at")
  resolvedByUserId String?    @map("resolved_by_user_id")
  venue       Restaurant      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([venueId, status])
  @@map("venue_trust_flags")
}

model Follow {
  userId       String     @map("user_id")
  restaurantId String     @map("restaurant_id")
  followedAt   DateTime   @default(now()) @map("followed_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@map("follows")
}

model DealRating {
  userId    String   @map("user_id")
  dealId    String   @map("deal_id")
  value     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([userId, dealId])
  @@map("deal_ratings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model VenueClaimRequest {
  id           String      @id @default(cuid())
  venueId      String      @map("venue_id")
  requestingUserId String  @map("requesting_user_id")
  contactPhone String      @map("contact_phone")
  contactEmail String      @map("contact_email")
  proofNotes   String      @map("proof_notes")
  status       ClaimRequestStatus @default(pending)
  createdAt    DateTime    @default(now()) @map("created_at")
  reviewedAt   DateTime?   @map("reviewed_at")
  venue        Restaurant  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requestingUser User      @relation("VenueClaimRequester", fields: [requestingUserId], references: [id], onDelete: Cascade)

  @@unique([requestingUserId, venueId])
  @@map("venue_claim_requests")
}

model DealView {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  sessionId String?  @map("session_id")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, viewedAt])
  @@map("deal_views")
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  dealId    String   @map("deal_id")
  kind      String
  sentAt    DateTime @default(now()) @map("sent_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId, kind])
  @@map("notification_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
