{
  "expo": {
    "name": "WhereToGo",
    "slug": "exp19216801018081",
    "owner": "tritone",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/icon.png",
    "scheme": "wheretogo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haragedek.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WhereToGo uses your location to show nearby restaurants and deals.",
        "LSApplicationQueriesSchemes": [
          "waze"
        ]
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#09090e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.haragedek.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WhereToGo to show nearby venues and your position on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WhereToGo to choose a venue logo or photo for merchant registration.",
          "cameraPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WhereToGo merchants to scan customer offer QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090e",
          "dark": {
            "backgroundColor": "#09090e"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c674cdab-0eda-4a02-a15b-8994b7cc5a4f"
      }
    }
  }
}
