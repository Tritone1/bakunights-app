{
  "expo": {
    "name": "WhereToGo",
    "slug": "haragedek",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/images/icon.png",
    "scheme": "haragedek",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haragedek.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WhereToGo uses your location to show nearby restaurants and deals.",
        "LSApplicationQueriesSchemes": ["bolt", "waze"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f0f4f9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.haragedek.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WhereToGo to show nearby venues and your position on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WhereToGo to choose a venue logo or photo for merchant registration.",
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2e5ba8",
          "dark": {
            "backgroundColor": "#1e3f7f"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
